# Web settings of the Firebase project, used by "Sign up with Google" (src/lib/googleSignIn.ts).
# Firebase console -> Project settings -> General -> Your apps (Web). Set the same three in Vercel -> Settings -> Environment Variables.
# Also in the Firebase console: Authentication -> Sign-in method -> enable Google; Authentication -> Settings -> Authorized domains -> add the site domain.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
