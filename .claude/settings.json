{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "backend-design@anthropic-plugin-directory": true,
    "vectorlab-ui-ux-skills@anthropic-plugin-directory": true,
    "playwright@anthropic-plugin-directory": true
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.production)",
      "Read(**/.env.resend)",
      "Bash(cat *.env)",
      "Bash(type *.env)",
      "Bash(head *.env)",
      "Bash(tail *.env)",
      "Bash(grep * *.env)",
      "Bash(source *.env)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(rm --recursive *)",
      "PowerShell(Remove-Item -Recurse*)",
      "PowerShell(Remove-Item * -Recurse*)"
    ]
  }
}
