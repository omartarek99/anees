# Dependencies
node_modules/
fastapi-backend/.venv/
fastapi-backend/__pycache__/
fastapi-backend/**/__pycache__/

# Build output
dist/
*.tsbuildinfo

# Local SQLite database — regenerated automatically (with seed data) on first `npm run dev`
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/*.bak

# Generated reel videos — recreated on demand by POST /reels/generate
fastapi-backend/assets/*.mp4

# Env files (none committed by default — guard against future secrets)
.env
.env.local
.env.*.local

# Claude Code agent worktrees (created/cleaned up by the harness)
.claude/worktrees/

# Personal Claude Code settings (hooks, permissions) — not meant to be shared; each
# contributor gets their own via `npx impeccable install` or their own tool choices.
.claude/settings.local.json
# Impeccable's compiled engine binary — platform-specific (Windows here) and re-downloaded
# by `npx impeccable install`; the skill's own markdown reference docs stay tracked.
.claude/skills/*/scripts/bin/
# Impeccable's local cache/config — regenerated automatically, not source.
.impeccable/

# Firebase/GCP service account keys — full admin credentials, never commit
*service-account*.json
backend/secrets/

# tesseract.js OCR language data — downloaded/cached on first ID-verification run
backend/*.traineddata

# Editor/OS cruft
.DS_Store
Thumbs.db
