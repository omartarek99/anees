# Same Supabase project fastapi-backend/ uses (Project Settings -> API).
# Auth moved to Firebase (see FIREBASE_API_KEY below) -- Supabase is only used now for
# the private teacher ID document Storage bucket.
SUPABASE_URL=
# Service role key -- needed for the teacher ID upload to private Storage. Never expose
# this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Firebase project's Web API Key (Project Settings -> General) -- used server-side to
# call Firebase Auth's Identity Toolkit REST API for signup/login/email verification.
FIREBASE_API_KEY=
