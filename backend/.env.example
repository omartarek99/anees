# REQUIRED -- unlike everything else in this file, the app will not boot without this one.
# 32-byte AES-256-GCM key (64 hex chars) used to encrypt sensitive user data (currently:
# email) at rest -- see backend/src/lib/encryption.ts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this key after data has been encrypted with it makes that data unreadable --
# treat it like any other secret you can't afford to lose, not something to rotate casually.
ENCRYPTION_KEY=

# Same Supabase project fastapi-backend/ uses (Project Settings -> API).
# Auth moved to Firebase (see FIREBASE_API_KEY below) -- Supabase is only used now for
# the private teacher ID document Storage bucket.
SUPABASE_URL=
# Service role key -- needed for the teacher ID upload to private Storage. Never expose
# this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Firebase project's Web API Key (Project Settings -> General) -- used server-side to
# call Firebase Auth's Identity Toolkit REST API for signup/login/email verification.
FIREBASE_API_KEY=

# Where the verification email's link should send the student/teacher back to -- must match
# the frontend dev server's actual origin (frontend/vite.config.ts pins the port; check it
# there rather than assuming Vite's 5173 default). Defaults to http://localhost:5190 if unset
# (see backend/src/lib/config.ts -- the one place that default lives).
FRONTEND_ORIGIN=http://localhost:5190

# Google Gemini API key (Google AI Studio -> Get API key) -- used server-side to
# auto-generate teacher reel quiz questions from the lesson script. Without it, the
# "Auto-generate questions" button in the reel composer returns a clear error; manual
# question entry is unaffected.
GEMINI_API_KEY=
