# Copy this file to .env and fill in the values from your Supabase project settings
# (Project Settings → API). Never commit the real .env file.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret callers must send as the X-API-Key header. Required: with it unset, every
# route except /health answers 401. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
